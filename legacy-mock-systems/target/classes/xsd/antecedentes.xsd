<?xml version="1.0" encoding="UTF-8"?>
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema"
           xmlns:tns="http://ex.com/mock/antecedentes"
           targetNamespace="http://ex.com/mock/antecedentes"
           elementFormDefault="qualified">

    <xs:element name="ConsultaAntecedentesRequest">
        <xs:complexType>
            <xs:sequence>
                <xs:element name="cpf" type="xs:string"/>
            </xs:sequence>
        </xs:complexType>
    </xs:element>

    <xs:element name="ConsultaAntecedentesResponse">
        <xs:complexType>
            <xs:sequence>
                <xs:element name="cpf" type="xs:string"/>
                <xs:element name="possuiRestricao" type="xs:boolean"/>
                <xs:element name="tipoRestricao" type="xs:string" minOccurs="0"/>
                <xs:element name="dataConsulta" type="xs:string"/>
            </xs:sequence>
        </xs:complexType>
    </xs:element>

</xs:schema>
